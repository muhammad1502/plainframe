{
  "name": "Plainframe",
  "short_name": "Plainframe",
  "description": "Remove location, camera details, AI prompts and Content Credentials from photos, on your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#190207",
  "theme_color": "#190207",
  "categories": ["photo", "utilities", "privacy"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "photos", "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp", ".avif", ".heic"] }] }
  }
}
